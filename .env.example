# =============================================================================
# EVALX Production & Development Environment Configuration
# =============================================================================

# Application Environment Mode
# Values: 'development', 'testing', 'production'
# In production, strict configuration validation is enforced at startup.
ENVIRONMENT=development
APP_NAME=EVALX
API_PORT=8000

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL with pgvector)
# -----------------------------------------------------------------------------
POSTGRES_DB=evalx
POSTGRES_USER=evalx
POSTGRES_PASSWORD=evalx_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://evalx:evalx_dev_password@localhost:5432/evalx

# Test Database (strictly isolated for integration test runs)
POSTGRES_TEST_DB=evalx_test
POSTGRES_TEST_USER=evalx_test
POSTGRES_TEST_PASSWORD=evalx_test_password
TEST_DATABASE_URL=postgresql+psycopg://evalx_test:evalx_test_password@localhost:5432/evalx_test

# Database Connection Pool Tuning (Optional, defaults shown)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30.0
DB_POOL_RECYCLE_SECONDS=1800

# -----------------------------------------------------------------------------
# Redis & Queue Configuration (ARQ)
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/1

# Redis Socket Timeouts
REDIS_SOCKET_TIMEOUT_SECONDS=5.0
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5.0

# Worker Settings
WORKER_CONCURRENCY=10
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY_SECONDS=5
WORKER_HEARTBEAT_TTL_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
ENABLE_SCHEDULER_IN_WORKER=true
STALE_RUN_TIMEOUT_HOURS=2

# -----------------------------------------------------------------------------
# Authentication & Tenancy (Clerk)
# Required in production: must be a real key, not a placeholder
# -----------------------------------------------------------------------------
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_JWT_KEY=""
CLERK_AUTHORIZED_PARTIES="http://localhost:3000,http://localhost:5173"

# -----------------------------------------------------------------------------
# Security & Network Boundaries
# -----------------------------------------------------------------------------
# CORS: comma-separated list of allowed origins (wildcard '*' forbidden in production)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
TRUSTED_PROXIES=""
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false
MAX_REQUEST_BODY_BYTES=5242880
RATE_LIMIT_ENABLED=true

# -----------------------------------------------------------------------------
# Evaluation Scheduling & Observability
# -----------------------------------------------------------------------------
MAX_ACTIVE_SCHEDULES_PER_TENANT=20
MIN_SCHEDULE_INTERVAL_MINUTES=15
SCHEDULER_POLL_INTERVAL_SECONDS=15
SCHEDULER_MAX_CATCHUP_HOURS=24
HEALTH_CHECK_TIMEOUT_SECONDS=3.0
